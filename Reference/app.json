{
  "expo": {
    "name": "Foodiya",
    "slug": "foodiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodiya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyrkul.foodiya",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#006D6F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyrkul.foodiya"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#006D6F",
          "dark": {
            "backgroundColor": "#004D4F"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Foodiya to access your photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Foodiya to access your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Foodiya to access your location."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#006D6F",
          "icon": "./assets/images/android-icon-monochrome.png",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pacifico-Regular.ttf",
            "./assets/fonts/UnifrakturCook-Bold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc61c355-6612-43f9-be14-f82bc851ca6a"
      }
    },
    "owner": "hyrkul"
  }
}
