# Local default is the unlinked template. Use likan with an existing Likan native build.
APP_BRAND=template
APP_VARIANT=development

# Optional Android Maps key restricted to the selected brand's Android package.
GOOGLE_MAPS_ANDROID_API_KEY=

# Identity API origin reachable from your iOS/Android device (no trailing /api).
EXPO_PUBLIC_API_URL=

# Reserved for the planned developer-screen capability; not consumed by routes yet.
EXPO_PUBLIC_ENABLE_DEV_SCREENS=false
