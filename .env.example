# Local default is the unlinked template. Use likan with an existing Likan native build.
APP_BRAND=template
APP_VARIANT=development

# Optional Android Maps key restricted to the selected brand's Android package.
GOOGLE_MAPS_ANDROID_API_KEY=

# Identity API origin reachable from your iOS/Android device (no trailing /api).
EXPO_PUBLIC_API_URL=

# Expose the native component catalog in this bundle (Home/Settings and direct URLs).
EXPO_PUBLIC_ENABLE_DEV_SCREENS=false

# Development-only Storybook route. npm run storybook opts into both preview flags.
EXPO_PUBLIC_STORYBOOK_ENABLED=false
$env:APP_BRAND = 'likan'
$env:APP_VARIANT = 'development'
npx eas-cli@latest build --platform android --profile development



npx eas-cli@latest build:run
