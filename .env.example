# Enable Maps SDK for Android for com.hyrkul.likan, then add an Android-restricted API key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Identity API origin reachable from your iOS/Android device (no trailing /api).
EXPO_PUBLIC_API_URL=

# EAS preview enables guest browsing and developer screens; production disables them.
# Set true for a local release export that should include the same screens as preview.
EXPO_PUBLIC_ENABLE_DEV_SCREENS=false
