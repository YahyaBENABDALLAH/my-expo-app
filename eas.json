{
  "cli": {
    "version": ">= 24.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_BRAND": "likan",
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_ENABLE_DEV_SCREENS": "true",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "env": {
        "APP_BRAND": "likan",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_ENABLE_DEV_SCREENS": "true",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "env": {
        "APP_BRAND": "likan",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ENABLE_DEV_SCREENS": "false",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
