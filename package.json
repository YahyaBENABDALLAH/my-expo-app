{
  "name": "my-app-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "57.0.21",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@shopify/react-native-skia": "2.6.2",
    "@stepperize/react": "^7.0.0",
    "@tanstack/react-query": "^5.96.2",
    "axios": "^1.15.0",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-in-app-updates": "0.13.0",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.14",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.22",
    "expo-observe": "~57.0.25",
    "expo-router": "57.0.24",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.0.3",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.7.0",
    "@storybook/addon-ondevice-controls": "10.7.0",
    "@storybook/react-native": "10.7.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "storybook": "10.6.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/ui": "$@expo/ui",
    "react-native-safe-area-context": "$react-native-safe-area-context",
    "@storybook/react": "10.6.2",
    "@storybook/react-native-ui": "10.7.0",
    "@storybook/react-native-ui-common": "10.7.0",
    "@storybook/react-native-theming": "10.7.0",
    "@storybook/react-dom-shim": "10.6.2",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "@storybook/mcp": {
      "valibot": "^1.5.0"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "esbuild": "~0.26.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "storybook": "expo start --dev-client --clear",
    "storybook:generate": "sb-rn-get-stories",
    "lint": "expo lint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "prepare": "node .husky/install.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src docs .agents .github .husky .rnstorybook \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check src docs .agents .github .husky .rnstorybook \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@react-native-firebase/app",
          "@react-native-firebase/messaging",
          "expo-in-app-updates"
        ]
      }
    },
    "install": {
      "exclude": [
        "@expo/ui",
        "expo-router"
      ]
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
